{
  "name": "venomous-snake",
  "version": "0.0.1",
  "private": true,
  "description": "A stealth-action 2D Python tutorial RPG",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "nx serve game",
    "build": "nx build game",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "type-check": "nx run-many --target=type-check --all",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "^23.3.0",
    "@nx/eslint-plugin": "^23.3.0",
    "@nx/js": "^23.3.0",
    "@nx/react": "^23.3.0",
    "@nx/vite": "^23.3.0",
    "@nx/workspace": "^23.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "nx": "^23.3.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "nx"
    ],
    "overrides": {
      "undici": "^7.29.1",
      "qs": "^6.16.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "i18next": "^26.5.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "react-i18next": "^17.1.0"
  }
}
